@echo off
rem ============================================================
rem  Generate Visual Studio solution via CMake into .\build
rem
rem  Usage:
rem    gen_vs_project.bat                 auto-detect VS, x64, generate
rem    gen_vs_project.bat x64 clean       delete build dir first, then generate
rem    gen_vs_project.bat Win32           generate 32-bit project
rem
rem  Prerequisites:
rem    1. Visual Studio 2022/2019/2017 with "Desktop development with C++"
rem    2. VCPKG_ROOT env var set (protobuf/fmt/gRPC come from vcpkg)
rem    3. cmake >= 3.5 in PATH
rem ============================================================
chcp 65001 >nul
setlocal EnableDelayedExpansion
cd /d "%~dp0"

set "ARCH=x64"
set "DO_CLEAN=0"
for %%a in (%*) do (
    if /i "%%a"=="clean" (
        set "DO_CLEAN=1"
    ) else (
        set "ARCH=%%a"
    )
)

rem ---------- check cmake ----------
where cmake >nul 2>nul
if errorlevel 1 (
    echo [ERROR] cmake not found in PATH, install CMake first
    exit /b 1
)

rem ---------- check VCPKG_ROOT ----------
if not defined VCPKG_ROOT (
    echo [ERROR] VCPKG_ROOT is not set.
    echo         Windows build needs protobuf/fmt/gRPC from vcpkg. Run:
    echo         setx VCPKG_ROOT D:\vcpkg
    echo         then reopen the terminal.
    exit /b 1
)
if not exist "%VCPKG_ROOT%\scripts\buildsystems\vcpkg.cmake" (
    echo [ERROR] %VCPKG_ROOT%\scripts\buildsystems\vcpkg.cmake not found
    exit /b 1
)

rem ---------- auto-detect Visual Studio ----------
set "GEN="
set "VSMajor="
set "VSWHERE=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe"
if exist "%VSWHERE%" (
    for /f "usebackq tokens=1 delims=." %%v in (`"%VSWHERE%" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationVersion 2^>nul`) do set "VSMajor=%%v"
)
if "%VSMajor%"=="17" set "GEN=Visual Studio 17 2022"
if "%VSMajor%"=="16" set "GEN=Visual Studio 16 2019"
if "%VSMajor%"=="15" set "GEN=Visual Studio 15 2017"
if not defined GEN (
    echo [ERROR] No usable Visual Studio found ^(C++ desktop workload required^)
    echo         Check with vswhere, or edit GEN in this script manually
    exit /b 1
)

rem ---------- vcpkg triplet for 32-bit ----------
set "VCPKG_TRIPLET="
if /i "%ARCH%"=="Win32" set "VCPKG_TRIPLET=-DVCPKG_TARGET_TRIPLET=x86-windows"

rem ---------- clean ----------
if "%DO_CLEAN%"=="1" (
    if exist "build" (
        echo [INFO] Removing old build directory...
        rmdir /s /q "build"
    )
)

echo [INFO] Generator : %GEN%
echo [INFO] Arch      : %ARCH%
echo [INFO] VCPKG_ROOT: %VCPKG_ROOT%
echo [INFO] Output    : %~dp0build
echo.

rem warn if existing cache was generated by another generator
if exist "build\CMakeCache.txt" (
    findstr /c:"CMAKE_GENERATOR:INTERNAL=%GEN%" "build\CMakeCache.txt" >nul 2>nul
    if errorlevel 1 (
        echo [WARN] build\CMakeCache.txt comes from another generator/config
        echo        If configure fails, run: gen_vs_project.bat %ARCH% clean
        echo.
    )
)

rem ---------- configure ----------
cmake -S . -B build -G "%GEN%" -A %ARCH% -DCMAKE_TOOLCHAIN_FILE="%VCPKG_ROOT%\scripts\buildsystems\vcpkg.cmake" %VCPKG_TRIPLET%
if errorlevel 1 (
    echo.
    echo [ERROR] CMake configure failed, see messages above
    exit /b 1
)

echo.
echo [OK] Solution generated: %~dp0build\tomnet.sln
echo      Open it in Visual Studio, or build from command line:
echo      cmake --build build --config Release
endlocal
exit /b 0
